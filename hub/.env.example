DATABASE_URL=postgresql://postgres:postgres@localhost:5432/remocode
JWT_SECRET=change-me-in-production-min-32-chars
PORT=3040
HUB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3040

# Phase 12.1 — Mobile Tauri client
# Adds `tauri://localhost` (iOS) and `https://tauri.localhost` (Android) to
# allowedOrigins and switches the session cookie to `SameSite=None; Secure;
# Partitioned` when the request originates from those origins.
MOBILE_TAURI_ORIGINS_ENABLED=true
# Bundle id used in Universal Link AASA + App Links assetlinks.json.
MOBILE_BUNDLE_ID=com.finedesignz.remo-code
# Apple Developer team id — required in production for iOS Universal Links.
# Defaults to the literal `TEAMID` so the AASA file is still served in dev.
MOBILE_APPLE_TEAM_ID=TEAMID
# Android signing cert SHA-256 fingerprint (upper-case, colon-separated).
# Defaults to the literal `SHA256_PLACEHOLDER` for dev.
MOBILE_ANDROID_SHA256_FINGERPRINT=SHA256_PLACEHOLDER
