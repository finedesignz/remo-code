{
  "name": "remo-code",
  "private": true,
  "workspaces": [
    "hub",
    "web",
    "mcp"
  ],
  "scripts": {
    "dev:hub": "cd hub && bun run dev",
    "dev:web": "cd web && bun run dev",
    "build:web": "cd web && bun run build",
    "ensure-web-error-project": "bun run hub/scripts/ensure-web-error-project.ts",
    "docs:sync": "cd hub && bun run docs:openapi && cd .. && npx --yes widdershins@4.0.1 --search false --language_tabs 'shell:Shell' 'javascript:JavaScript' --summary docs/openapi.json -o docs/api.md",
    "smoke": "bun run tools/smoke-https.ts",
    "check-baseline": "bun run tools/check-baseline.ts",
    "migration-verify": "bun run tools/migration-verify.ts",
    "schema-lint": "bun run tools/schema-sql-lint.ts",
    "orchestrator:e2e": "bun test hub/test/e2e/*.e2e.test.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@tailwindcss/vite": "^4.2.2",
    "pg": "^8.20.0"
  },
  "dependencies": {
    "rehype-sanitize": "^6.0.0"
  }
}
