VITE_HUB_URL=http://localhost:3040

# B3 observability: project_id for browser-side error capture. Minted once by
# `bun run ensure-web-error-project` from the repo root; the script prints
# the id. Leave unset locally to disable client-side reporting.
VITE_WEB_ERROR_PROJECT_ID=

# Optional release tag emitted with every captured browser error.
VITE_RELEASE=web@dev
