{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remo Code Supervisor",
  "version": "0.5.6",
  "identifier": "com.finedesignz.remo-code-supervisor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Remo Code Supervisor — Settings",
        "width": 720,
        "height": 560,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi"],
    "externalBin": ["binaries/remo-code-supervisor"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/finedesignz/remo-code/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzRDA1MEM3QkQzQ0EwMEIKUldRTG9EeTl4MURRUS9XL0JDTmVaMUsrQUQxcXk4a0lMcXFmaHl2bjBXeHA1SklSeXFTR1RqWWkK"
    }
  }
}
