{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Remo Code Supervisor tray app",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:event:default",
    "autostart:default",
    "global-shortcut:default",
    "updater:default",
    "process:default",
    "shell:default",
    "dialog:default"
  ]
}
