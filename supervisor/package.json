  "scripts": {
    "dev": "bun --watch src/index.ts run",
    "start": "bun src/index.ts run"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": ["claude", "claude-code", "remote", "supervisor", "remo-code"],
  "license": "MIT",
  "repository": {
    "type": "git",
